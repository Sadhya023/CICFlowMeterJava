@echo off
REM Simple Windows launcher to run the Python `cicflowmeter` wrapper script from repository root.
REM Usage: cicflowmeter.bat [args...]

REM Save current environment and ensure variables are local to this script
SETLOCAL

REM %~dp0 is the full path to the directory containing this batch file (with trailing backslash)
SET SCRIPT_DIR=%~dp0

REM Call python with the repo-local script and pass through all arguments
python "%SCRIPT_DIR%cicflowmeter" %*

ENDLOCAL

