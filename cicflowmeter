#!/usr/bin/env python3
"""
Wrapper CLI to start the Python adapter (`log_adapter.py`) and run CICFlowMeter in a single command.

Usage examples (PowerShell):
  ./cicflowmeter -p pcap\testpcap.pcap -u http://localhost:9001/receive_log -limit 10 -t 1
  ./cicflowmeter -i eth2 -u https://webhook.site/... -limit 10 -t 1

Description:
- Starts `log_adapter.py` (background) with environment variables set (MODEL_URL, MAX_SEND, BATCH_TIMEOUT).
- Waits for the adapter `/health` endpoint to return OK.
- If `-p/--pcap` is provided, runs `MainCLI` on that pcap file and points its `log_url` to the adapter.
- If `-i/--iface` is provided, uses `tshark` to capture short-duration pcaps (duration controlled by `-t`) and runs `MainCLI` on each captured pcap file until the adapter's `MAX_SEND` limit is reached.

Notes:
- Requires `python3`, `java` and optionally `tshark` (for live interface capture) available in PATH.
- Designed to be cross-platform but was developed for the repository's Windows environment.
"""

import argparse
import os
import subprocess
import sys
import time
import tempfile
import requests
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
ADAPTER = SCRIPT_DIR / 'log_adapter.py'
CIC_DIR = SCRIPT_DIR / 'CICFlowMeter-4.0'


def start_adapter(model_url, client_id, max_send, batch_size, batch_timeout, port=9001):
    env = os.environ.copy()
    env['MODEL_URL'] = model_url
    env['CLIENT_ID'] = client_id
    env['PORT'] = str(port)
    env['BATCH_SIZE'] = str(batch_size)
    env['BATCH_TIMEOUT'] = str(batch_timeout)
    if max_send is not None:
        env['MAX_SEND'] = str(max_send)

    # propagate optional resource and include_confidence settings
    if 'RESOURCE_ID' in os.environ:
        env['RESOURCE_ID'] = os.environ.get('RESOURCE_ID')
    # If calling code provided include_confidence via environment use it,
    # otherwise default to adapter value (false)
    if os.environ.get('INCLUDE_CONFIDENCE'):
        env['INCLUDE_CONFIDENCE'] = os.environ.get('INCLUDE_CONFIDENCE')

    # Start adapter in background
    print(f"Starting adapter (log_adapter.py) -> {model_url}")
    # Use Popen so we can continue; on Windows, stdout/stderr will appear in the spawned process window.
    p = subprocess.Popen([sys.executable, str(ADAPTER)], env=env)
    return p


def wait_for_health(port=9001, timeout=30.0):
    url = f'http://127.0.0.1:{port}/health'
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            r = requests.get(url, timeout=1.0)
            if r.status_code == 200:
                j = r.json()
                if j.get('status') in ('ok', 'OK', True):
                    print('Adapter health OK')
                    return True
        except Exception:
            pass
        time.sleep(0.5)
    return False


def run_maincli_on_pcap(pcap_path, model_url):
    # Run java MainCLI <pcap> <outcsv> <log_url>
    # Use bin_compiled on the classpath if present else lib/*
    workdir = CIC_DIR
    java_cmd = ['java', '-cp', 'bin_compiled;lib/*', 'MainCLI', str(pcap_path), str(workdir / 'output' / (pcap_path.name + '_Flow.csv')), model_url]
    print('Running MainCLI:', ' '.join(java_cmd))
    try:
        # Start MainCLI as a subprocess so we can terminate it if the adapter exits
        proc = subprocess.Popen(java_cmd, cwd=str(workdir))
        return proc
    except FileNotFoundError:
        print('java not found in PATH.')
        return None


def capture_with_tshark(iface, duration_sec, out_path):
    # Requires tshark available. Use -a duration: to capture for fixed seconds
    cmd = ['tshark', '-i', iface, '-a', f'duration:{int(duration_sec)}', '-w', str(out_path)]
    print('Capturing:', ' '.join(cmd))
    try:
        proc = subprocess.run(cmd, check=False)
        return proc.returncode == 0
    except FileNotFoundError:
        print('tshark not found in PATH. Install Wireshark/tshark to capture live interfaces.')
        return False


def main():
    ap = argparse.ArgumentParser(prog='cicflowmeter', description='Start adapter + CICFlowMeter together (single command)')
    group = ap.add_mutually_exclusive_group(required=True)
    group.add_argument('-i', '--iface', help='Network interface to capture (live). Requires tshark.')
    group.add_argument('-p', '--pcap', help='PCAP file to process')
    ap.add_argument('-u', '--url', required=True, help='Model/webhook URL (adapter will forward to this URL)')
    ap.add_argument('-limit', type=int, default=None, help='Total number of flows to forward (adapter MAX_SEND)')
    ap.add_argument('-t', '--time', type=float, default=1.0, help='Capture slice duration (seconds) or adapter flush timeout')
    ap.add_argument('--client', default='demo-client-0001', help='CLIENT_ID to include in payloads')
    ap.add_argument('--resource-id', default=None, help='RESOURCE_ID to include in payloads (optional)')
    ap.add_argument('--include-confidence', action='store_true', help='If set include top-level include_confidence=true in payloads')
    ap.add_argument('--batch-size', type=int, default=10, help='Adapter batch size')
    args = ap.parse_args()

    port = 9001
    # Export RESOURCE_ID / INCLUDE_CONFIDENCE to adapter env
    if args.resource_id:
        os.environ['RESOURCE_ID'] = args.resource_id
    if args.include_confidence:
        os.environ['INCLUDE_CONFIDENCE'] = 'true'

    adapter_proc = start_adapter(args.url, args.client, args.limit, args.batch_size, args.time, port=port)
    try:
        ok = wait_for_health(port=port, timeout=20.0)
        if not ok:
            print('Adapter did not become healthy within timeout. Check logs. Exiting.')
            adapter_proc.terminate()
            return 1

        model_endpoint = f'http://127.0.0.1:{port}/receive_log'

        if args.pcap:
            p = Path(args.pcap)
            if not p.exists():
                print('PCAP file not found:', args.pcap)
                adapter_proc.terminate()
                return 1
            # Launch MainCLI and monitor adapter; terminate MainCLI if adapter exits
            mainproc = run_maincli_on_pcap(p, model_endpoint)
            if mainproc is None:
                adapter_proc.terminate()
                return 1
            try:
                while True:
                    try:
                        # Wait briefly for MainCLI to finish
                        rc = mainproc.wait(timeout=0.5)
                        print('MainCLI returned', rc)
                        break
                    except subprocess.TimeoutExpired:
                        # If adapter exited, stop MainCLI to avoid further POSTs
                        if adapter_proc.poll() is not None:
                            print('Adapter exited; terminating MainCLI.')
                            try:
                                mainproc.terminate()
                            except Exception:
                                pass
                            try:
                                mainproc.kill()
                            except Exception:
                                pass
                            break
            except KeyboardInterrupt:
                try:
                    mainproc.terminate()
                except Exception:
                    pass
                adapter_proc.terminate()
                return 1
        else:
            # live capture mode: loop, capture a short pcap slice then run MainCLI on it
            seq = 0
            while True:
                tmp_pcap = Path(tempfile.gettempdir()) / f'cic_capture_{int(time.time())}_{seq}.pcap'
                okcap = capture_with_tshark(args.iface, args.time, tmp_pcap)
                if not okcap:
                    print('Capture failed. Exiting.')
                    break

                # Start MainCLI as a subprocess so we can kill it if adapter exits
                mainproc = run_maincli_on_pcap(tmp_pcap, model_endpoint)
                if mainproc is None:
                    print('Failed to start MainCLI for captured pcap.')
                    try:
                        tmp_pcap.unlink()
                    except Exception:
                        pass
                    break
                # Wait for MainCLI to finish while observing adapter state
                try:
                    while True:
                        try:
                            rc = mainproc.wait(timeout=0.5)
                            break
                        except subprocess.TimeoutExpired:
                            if adapter_proc.poll() is not None:
                                print('Adapter exited; terminating MainCLI.')
                                try:
                                    mainproc.terminate()
                                except Exception:
                                    pass
                                try:
                                    mainproc.kill()
                                except Exception:
                                    pass
                                break
                except KeyboardInterrupt:
                    try:
                        mainproc.terminate()
                    except Exception:
                        pass
                    break
                try:
                    tmp_pcap.unlink()
                except Exception:
                    pass
                seq += 1
                # Check if adapter reached MAX_SEND by polling health buffer or exit condition
                if args.limit is not None:
                    # we will query last_sent_payload.json if present to count forwarded flows (best-effort)
                    # but adapter will itself exit when MAX_SEND is reached; poll process state
                    if adapter_proc.poll() is not None:
                        print('Adapter exited (likely reached MAX_SEND). Stopping capture loop.')
                        break
                # small pause to avoid tight loop
                time.sleep(0.1)

        # wait for adapter to finish if it will (MAX_SEND) else leave running
        if args.limit is not None:
            # adapter exits when MAX_SEND reached; wait for it
            try:
                adapter_proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                print('Adapter still running; terminating.')
                adapter_proc.terminate()
    finally:
        # best-effort cleanup
        if adapter_proc.poll() is None:
            try:
                adapter_proc.terminate()
            except Exception:
                pass

    return 0

if __name__ == '__main__':
    sys.exit(main())

